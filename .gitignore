# .claude holds BOTH machine-local state and shareable project assets. Ignore the
# directory's contents, then re-include the shareable subdirectories so skills,
# slash commands and agent definitions can be version-controlled with the project.
# Note the trailing /* -- with a bare `.claude/` git never descends into the
# directory and the !-rules below can never match.
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/agents/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.codex/
.hermes/
.kiro_video_review/
.rider/
.opencode.json
.stylelintrc.json

# Large binary dumps (not for plain git — use LFS if needed)
Saved/
generated/
Imports/
VFX/
my-site-deploy/
toolchain/**/exports/

# Build artifacts and non-project dirs
qdk-learning/
O58pkg/
O58src/

# Embody / Envoy (auto-managed)
Backup/
logs/
CrashAutoSave*
.embody/*
!.embody/project.json
.claude/projects/
.DS_Store

