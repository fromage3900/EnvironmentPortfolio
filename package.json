{
  "devDependencies": {
    "@wix/cli": "^1.0.0",
    "@wix/eslint-plugin-cli": "^1.0.0",
    "eslint": "^8.25.0",
    "postcss-scss": "^4.0.9",
    "react": "16.14.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^8.2.1"
  },
  "scripts": {
    "postinstall": "wix sync-types",
    "dev": "wix dev",
    "lint": "eslint --resolve-plugins-relative-to . .",
    "lint:css": "stylelint wix/**/*.css --custom-syntax postcss-scss",
    "lint:tokens": "node tools/lint-tokens.js",
    "paths:wix": "python tools/normalize-paths.py wix",
    "paths:github": "python tools/normalize-paths.py github",
    "verify:manifest": "python tools/verify_deployment_manifest.py",
    "verify:all": "npm run lint:tokens && python tools/_verify_site_facts.py && python tools/validate_assets.py",
    "validate:liveops": "python tools/validate_gacha.py --strict && python tools/validate_feature_flags.py",
    "validate:gacha": "python tools/validate_gacha.py --strict",
    "validate:flags": "python tools/validate_feature_flags.py",
    "lfs:guard": "python tools/git_lfs_guard.py",
    "lfs:guard:ci": "set GITHUB_ACTIONS=true && python tools/git_lfs_guard.py",
    "release": "python tools/bump_version.py",
    "health": "python BS_GodFile/Tools/health.py --offline",
    "research": "python BS_GodFile/Tools/rhythm_research_runner.py --iterations 3",
    "models": "python tools/pull_fleet.py --dry-run",
    "models:pull": "python tools/pull_fleet.py",
    "models:worker": "python tools/pull_fleet.py granite4.2:8b",
    "models:reasoner": "python tools/pull_fleet.py muse-glimmer:30b",
    "models:ping": "python tools/pull_fleet.py granite4.2:3b",
    "overnight": "python scripts/overnight_daemon.py",
    "overnight:once": "python scripts/overnight_daemon.py --once",
    "overnight:health": "python scripts/overnight_daemon.py --health-only",
    "overnight:dry-run": "python scripts/overnight_daemon.py --dry-run",
    "overnight:playhouse": "python scripts/overnight_daemon.py --lanes health,playhouse --once",
    "overnight:forums": "python scripts/overnight_daemon.py --lanes forums --once",
    "overnight:register-tasks": "powershell -ExecutionPolicy Bypass -File tools/register_overnight_tasks.ps1",
    "overnight:start": "tools/start_overnight.cmd",
    "git:mirror:check": "python tools/git_mirror.py --check",
    "git:mirror:push": "python tools/git_mirror.py --all",
    "test:mcp": "python BS_GodFile/Tools/test_melodia_mcp.py",
    "test:p0-economy": "python BS_GodFile/Tools/test_p0_economy_mcp.py"
  }
}