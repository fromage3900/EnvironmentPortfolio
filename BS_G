#!/usr/bin/env python3
"""Melodia Pre-Merge Guard - refuse merges that will fail mid-checkout.

The 2026-08-22 G:->C: merge failed three times because Unreal Editor held
.uasset locks while git tried to replace tracked binaries. This guard turns
that multi-day pause pattern into a 10-second error message.

Run manually before any risky merge:
    python Tools/pre_merge_guard.py [--repo PATH]

Or let git invoke it automatically: it is wired as .githooks/pre-merge-commit,
and this repo sets core.hooksPath=.githooks.

Checks:
  1. UnrealEditor.exe running          -> CRIT (holds Content locks)
  2. Existing MERGE_HEAD               -> CRIT (merge already in progress)
  3. Uncommitted changes               -> WARN (merge will refuse or tangle)
  4. Stale *.lock files under .git     -> WARN

Exit codes: 0 safe, 1 warnings only, 2 blocked.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

DEFAULT_REPO = Path(__file__).resolve().parent.parent


def sh(args: list[str]) -> tuple[int, str]:
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=60,
                           encoding="utf-8", errors="replace")
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def editor_running() -> str | None:
    rc, out = sh(["tasklist", "/FI", "IMAGENAME eq UnrealEditor.exe", "/FO", "CSV", "/NH"])
    if rc == 0 and "UnrealEditor" in out:
        for line in out.splitlines():
            if "UnrealEditor" in line:
                parts = line.split('","')
                return parts[1].strip('"') if len(parts) > 1 else "?"
    return None


def main() -> int:
    ap = argparse.ArgumentParser(description="Block merges that would fail on file locks")
    ap.add_argument("--repo", default=str(DEFAULT_REPO))
    args = ap.parse_args()
    repo = Path(args.repo).resolve()

    problems: list[str] = []
    warnings: list[str] = []

    pid = editor_running()
    if pid:
        problems.append(
            f"UnrealEditor.exe is running (PID {pid}) and holds .uasset locks. "
            "Close the editor before merging."
        )
    else:
        print("[ ok ] no Unreal Editor running - lock window is clear")

    merge_head = repo / ".git" / "MERGE_HEAD"
    if merge_head.exists():
        problems.append("MERGE_HEAD exists - a merge is already in progress.")
    else:
        print("[ ok ] no merge in progress")

    rc, out = sh(["git", "-C", str(repo), "status", "--porcelain"])
    dirty = [l for l in out.splitlines() if l.strip()] if rc == 0 else []
    if dirty:
        warnings.append(f"{len(dirty)} uncommitted changes - commit or stash them first.")
    else:
        print("[ ok ] worktree clean")

    stale = [str(p.relative_to(repo / ".git")) for p in (repo / ".git").rglob("*.lock") if p.is_file()]
    if stale:
        warnings.append("stale git locks: " + ", ".join(stale[:5]))
    else:
        print("[ ok ] no stale git locks")

    for w in warnings:
        print(f"[WARN] {w}")
    for p in problems:
        print(f"[CRIT] {p}")

    if problems:
        print("
MERGE BLOCKED. Resolve the critical items above, then retry.")
        return 2
    if warnings:
        print("
Merge allowed with warnings.")
        return 1
    print("
Safe to merge.")
    return 0


if __name__ == "__main__":
    sys.exit(main())