    - tdn
  containerCOMP:
    parameters:
      resizecomp: =me
      repocomp: =me
  fbxCOMP:
    parameters:
      index: =me.time.frame
    size: [160, 130]
    color: [0.3, 0.5, 0.9]
    tags:
    - tdn
  compositeTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  transformTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  circleTOP:
    parameters:
      fillalpha: 0
      borderwidth: 0.004
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: containerCOMP
parameters:
  w: 1280
  h: 720
  resizecomp: =me
  repocomp: =me
  top: ./out1
  borderover: false
  parentshortcut: Project
sequences:
  ext:
  - object: op('./MelodiaStudioCore').module.MelodiaStudioCore(me)
    name: MelodiaStudioCore
    promote: true
  - object: op('./GraphManagerExt').module.GraphManagerExt(me)
    name: GraphManagerExt
    promote: true
