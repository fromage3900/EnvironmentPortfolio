source_file: grandmaster_melodia.1.toe
exported_at: '2026-08-27T07:18:04Z'
network_path: /project1
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  baseCOMP:
    size: [160, 130]
    color: [0.3, 0.5, 0.9]
