annotations:
- name: annotate6
  mode: annotate
  title: Annotate
  position: [892, -75]
  size: [382, 288]
  color: [0.45, 0.45, 0.45]
- name: annotate_audio
  mode: annotate
  title: AUDIO  — Melodia Audio Engine
  text: |-
    Vocal/audio analysis engine (35 ops).
    ain(audiofileinCHOP MP3) -> afilter(audiofilterCHOP) -> aout(audiodeviceoutCHOP);
    5-band filter+analyze+lag chains band1..band5;
    chord_detector / pitch_analyzer / spectral_analyzer;
    audio_feature_merge + hsv_math.
  position: [1050, -520]
  size: [640, 340]
  color: [0.2902, 0.2431, 0.3686]
  opacity: 0.85
- name: annotate_composite
  mode: annotate
  title: COMPOSITE  — Starfield + PostFX Out
  text: |-
    Output composite room.
    starfield (noise1->blur1->level1->transform1->out1);
    postfx (bg_nebula, bloom chain, LUT, vignette);
    final /project1/out1 -> spoutout1.
  position: [-560, -260]
  size: [600, 320]
  color: [0.9608, 0.9294, 1.0]
  opacity: 0.85
- name: annotate_perform
  mode: annotate
  title: PERFORM  — Hand OSC + Gesture
  text: |-
    Live hand-tracking bridge.
    hand_osc (oscinCHOP port 7000);
    osc COMP: in_battle + beat_pulse_* + preset matrix;
    feeds starfield transform1 tx/ty/rotate/sx/sy (EXPRESSION-BOUND - do not touch).
  position: [-560, 620]
  size: [560, 320]
  color: [0.7176, 0.4784, 0.6196]
  opacity: 0.85
- name: annotate_scene
  mode: annotate
  title: SCENE  — Spout/Blender Video In
  text: |-
    Blender/Spout video input room.
    Core: spoutout1 (syphonspoutoutTOP) fed by /project1/out1;
    pulse_transform + comp_stars preview taps.
  position: [-1080, 380]
  size: [620, 300]
  color: [0.8314, 0.6863, 0.2157]
  opacity: 0.85
