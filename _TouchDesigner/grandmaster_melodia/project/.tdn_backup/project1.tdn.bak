- name: mcp_test1
  type: sliderCOMP
  parameters:
    resizecomp: =me
    repocomp: =me
    clone: =op.TDTox.op('defaultCOMPs/slider')
  position: [154, -261]
  size: [160, 76]
  children:
  - name: knob
    type: containerCOMP
    parameters:
      x: =(parent().par.zonel + [tdu.remap(parent().par.value0.eval(), parent().par.valuerange0l.eval(), parent().par.valuerange0h.eval(), 0., 1.), 0., tdu.remap(parent().par.value0.eval(), parent().par.valuerange0l.eval(), parent().par.valuerange0h.eval(), 0., 1.)][parent().par.slidertype] * (parent().par.zoner-parent().par.zonel)) * parent().width - [0., me.width/2][me.width<5]
      y: =(parent().par.zoneb + [0., tdu.remap(parent().par.value1.eval(), parent().par.valuerange1l.eval(), parent().par.valuerange1h.eval(), 0., 1.), tdu.remap(parent().par.value1.eval(), parent().par.valuerange1l.eval(), parent().par.valuerange1h.eval(), 0., 1.)][parent().par.slidertype] * (parent().par.zonet-parent().par.zoneb)) * parent().height - [0., me.height/2][me.height<5]
      w: =parent().width if parent().par.slidertype == 'sliderv' else  4
      h: =parent().height if parent().par.slidertype == 'slideru' else 4
      layer: 2
      clickthrough: true
      bgcolorr: =.2 * parent().par.colorr + .5
      bgcolorg: =.2 * parent().par.colorg + .5
      bgcolorb: =.2 * parent().par.colorb + .5
      bgalpha: 1
      borderover: false
    flags:
    - viewer
    position: [25, -225]
    size: [118, 113]
  - name: out1
    type: outCHOP
    parameters:
      label: =me.name
      autoexportroot: =parent()
    flags:
    - viewer
    position: [200, -100]
    size: [130, 90]
    inputs:
    - par1
  - name: par1
    type: parameterCHOP
    parameters:
      parameters: ='value0 value1' if parent().par.slidertype == 'slideruv' else 'value0'
      custom: false
      builtin: true
      renameto: v1 v2
      autoexportroot: =parent()
    flags:
    - viewer
    position: [0, -100]
    size: [130, 90]
  - name: text
    type: textCOMP
    parameters:
      text: =parent().par.label
      type: multiline
      legacyfontselection: true
      scaletofit: onlyshrink
      fontsize: 10
      fontcolorr: =.2 * parent().par.colorr + .5
      fontcolorg: =.2 * parent().par.colorg + .5
      fontcolorb: =.2 * parent().par.colorb + .5
      textpaddingl: 4
      textpaddingr: 4
      textpaddingb: 3
      textpaddingt: 3
      alignx: left
      hmode: fill
      vmode: fill
      clickthrough: true
      resizecomp: =me
      repocomp: =me
      bgcolorr: =0.4 * parent().par.colorr
      bgcolorg: =0.4 * parent().par.colorg
      bgcolorb: =0.4 * parent().par.colorb
      bgalpha: 1
      borderar: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorr + 0.2
      borderag: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorg + 0.2
      borderab: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorb + 0.2
      leftborder: bordera
      rightborder: bordera
      bottomborder: bordera
      topborder: bordera
      borderover: false
    flags:
    - viewer
    position: [175, -225]
    size: [160, 76]
  - name: panelexec1
    type: panelexecuteDAT
    parameters:
      fromop: =parent()
      panels: =parent()
      panelvalue: u v
      offtoon: false
      valuechange: true
      defaultreadencoding: cp1252
      loadonstart: true
    flags:
    - viewer
    position: [75, -325]
    size: [124, 51]
