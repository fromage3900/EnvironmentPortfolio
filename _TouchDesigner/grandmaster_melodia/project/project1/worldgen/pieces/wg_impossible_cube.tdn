- name: effect_point
  type: pointSOP
  parameters:
    tx: =me.inputPoint.x
    ty: =me.inputPoint.y
    tz: =me.inputPoint.z
    weight: =me.inputPoint.w
    doclr: 'on'
    diffr: =0.75 + 0.25 * math.sin(me.inputPoint.P[1] * 0.5 + absTime.seconds * 3.0)
    diffg: =0.60 + 0.35 * math.cos(me.inputPoint.P[1] * 0.4 + absTime.seconds * 2.5)
    diffb: =0.90 + 0.10 * math.sin(me.inputPoint.P[1] * 0.3 - absTime.seconds * 2.0)
    alpha: =me.inputColor[3]
    nx: =me.inputNormal[0]
    ny: =me.inputNormal[1]
    nz: =me.inputNormal[2]
    mapu: =me.inputTexture[0]
    mapv: =me.inputTexture[1]
    mapw: =me.inputTexture[2]
    width: =me.inputPoint.width[0]
    pscale: =me.inputPoint.pscale[0]
    tension: =me.inputPoint.tension[0]
    springk: =me.inputPoint.springk[0]
    vx: =me.inputPoint.v[0]
    vy: =me.inputPoint.v[1]
    vz: =me.inputPoint.v[2]
    upx: =me.inputPoint.up[0]
    upy: =me.inputPoint.up[1]
    upz: =me.inputPoint.up[2]
  flags:
  - display
  - render
