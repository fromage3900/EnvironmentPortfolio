    strength: =math.sin(absTime.seconds * 1.2) * 12.0 + (op('/project1/audio/final_out')['beat'].eval() if op('/project1/audio/final_out') else 0.0) * 18.0
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - effect_facet
