#!/bin/sh
# Melodia pre-commit hook (fallback when pre-commit framework is not installed)
# Runs the same validators as .pre-commit-config.yaml in plain POSIX sh.

set -eu

# Git for Windows may launch hooks with a PATH that omits its POSIX helpers.
PATH="/usr/bin:$PATH"
export PATH

for REQUIRED_TOOL in dirname grep python; do
    command -v "$REQUIRED_TOOL" >/dev/null 2>&1 || {
        echo "ERROR: required hook command is unavailable: $REQUIRED_TOOL" >&2
        exit 1
    }
done

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

fail=0

run() {
    echo "▶ $1"
    if ! eval "$2"; then
        echo -e "${RED}✗ $1 failed${NC}"
        fail=1
    else
        echo -e "${GREEN}✓ $1 passed${NC}"
    fi
}

# Only run gacha validators when liveops/ changed
if git diff --cached --name-only | grep -qE '^liveops/'; then
    run "Validate gacha / economy configs" "python tools/validate_gacha.py"
    run "Validate feature flags" "python tools/validate_feature_flags.py"
fi

# Only run token linter when wix/ changed
if git diff --cached --name-only | grep -qE '^wix/'; then
    run "Lint design tokens" "node tools/lint-tokens.js"
fi

# Always run LFS lock guard when binary files are touched
run "LFS lock guard" "python tools/git_lfs_guard.py"

if [ "$fail" -ne 0 ]; then
    echo -e "${RED}Pre-commit failed. Fix issues before committing.${NC}"
    exit 1
fi
