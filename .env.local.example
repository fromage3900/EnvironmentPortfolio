# OpenCode provider keys (load via {env:VAR} in .opencode.json)
# Set these in your Windows env vars via `setx VAR "value"` or in C:\EnvironmentPortfolio\.env
OPENROUTER_API_KEY=your_openrouter_key_here
TOKENROUTER_API_KEY=your_tokenrouter_key_here
FIGMA_API_KEY=your_figma_personal_access_token_here

# Legacy var (alias for Figma) - prefer FIGMA_API_KEY
FIGMA_TOKEN=your_figma_personal_access_token_here

# Optional: Override default file key (Melodia Grandmaster)
# FIGMA_FILE_KEY=Yx8ud7n39NdWZvnNvo4Xlf