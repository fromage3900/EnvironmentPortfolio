{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://melodia.dev/schemas/banner.schema.json",
  "title": "Melodia Gacha Banner",
  "type": "object",
  "required": ["id", "name", "start_utc", "end_utc", "currency", "pools", "pity"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "start_utc": { "type": "string", "format": "date-time" },
    "end_utc": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "enum": ["PRIMOGEM", "INTERTWINED_FATE", "STARDUST", "STARGLITTER"] },
    "featured_items": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rarity", "rate", "items"],
        "properties": {
          "rarity": { "type": "integer", "minimum": 1, "maximum": 6 },
          "rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "is_guaranteed": { "type": "boolean", "default": false }
        }
      }
    },
    "pity": {
      "type": "object",
      "required": ["soft", "hard", "guarantee_rarity"],
      "properties": {
        "soft": { "type": "integer", "minimum": 1 },
        "hard": { "type": "integer", "minimum": 1 },
        "guarantee_rarity": { "type": "integer", "minimum": 1, "maximum": 6 },
        "carryover_banner_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "region_whitelist": { "type": "array", "items": { "type": "string" } },
        "region_blacklist": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
